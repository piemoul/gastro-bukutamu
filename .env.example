# Isi nilai asli di .env (diabaikan Git), bukan di file contoh ini.
DATABASE_URL=
SESSION_SECRET=
ADMIN_PASSWORD=
NFH_EVENT_PASSWORD=
FHI_EVENT_PASSWORD=
BALI_EVENT_PASSWORD=

# Local Docker database only. Leave NEON_FETCH_ENDPOINT unset on Vercel/Neon.
# The Docker setup uses DATABASE_URL pointing to bukutamu-db, not the live Neon database.
# DATABASE_URL=postgresql://bukutamu:<LOCAL_POSTGRES_PASSWORD>@bukutamu-db:5432/bukutamu
# NEON_FETCH_ENDPOINT=http://bukutamu-proxy:8080/sql
LOCAL_POSTGRES_PASSWORD=
NEON_FETCH_ENDPOINT=
